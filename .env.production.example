# ─────────────────────────────────────────────────────────────────────────────
# PRODUCTION ENVIRONMENT VARIABLES — DO NOT COMMIT REAL VALUES
#
# Add each of these as GitHub Secrets:
# Repo → Settings → Secrets and variables → Actions → New repository secret
# ─────────────────────────────────────────────────────────────────────────────

# ── SSH / Hostinger access ────────────────────────────────────────────────────
SSH_HOST=your-hostinger-server-ip-or-domain
SSH_USER=your-ssh-username
SSH_PASSWORD=your-ssh-password
DEPLOY_PATH=/home/your-username/public_html/kenvies   # path on the server

# ── Database (Hostinger MySQL) ────────────────────────────────────────────────
DB_USER=u547313549_jpos_admin
DB_PASSWORD=Jpos2025
DB_NAME=u547313549_jpos

# ── Node API server ───────────────────────────────────────────────────────────
SERVER_PORT=4000
JWT_SECRET=generate-a-long-random-string-here

# ── Frontend (Vite) ───────────────────────────────────────────────────────────
VITE_NODE_API_URL=https://yourdomain.com/api
VITE_JPOS_ROOT=https://yourdomain.com/JPos
VITE_IMAGE_BASE_URL=https://kenvies.com/userfiles/product
CORS_ORIGIN=https://yourdomain.com

# ── Google OAuth (optional) ───────────────────────────────────────────────────
# Client ID shown to users — share with frontend via VITE_ prefix
VITE_GOOGLE_CLIENT_ID=

# Client SECRET — SERVER ONLY. Never expose to frontend via VITE_ prefix.
GOOGLE_CLIENT_SECRET=

# Google OAuth callback URL registered in Google Cloud Console → Credentials
# → OAuth 2.0 Client IDs → Authorized redirect URIs.
#
# The server provides TWO equivalent endpoints (both use the same handler):
#   1. Root URL (pretty, use this in Google Console):
#        https://kenvimart.kenvies.com/google-auth-callback  ← RECOMMENDED
#   2. /api path (also works):
#        https://kenvimart.kenvies.com/api/auth/google/callback
#
# Uncomment and set this if Google Console uses a URL different from the
# auto-detected origin + /google-auth-callback (e.g. different domain).
# GOOGLE_AUTH_REDIRECT_URI=https://kenvimart.kenvies.com/google-auth-callback

# Optional: final SPA origin for the post-login redirect (defaults to
# CORS_ORIGIN or detected request origin). Use this if your React app is
# hosted on a domain different from the API server.
# GOOGLE_AUTH_REDIRECT_APP=https://kenvimart.kenvies.com

# Optional Vite override for frontend-initiated Google redirect (defaults to
# window.location.origin + '/google-auth-callback')
# VITE_GOOGLE_AUTH_REDIRECT_URI=https://kenvimart.kenvies.com/google-auth-callback
