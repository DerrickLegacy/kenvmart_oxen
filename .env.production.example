# ─────────────────────────────────────────────────────────────────────────────
# PRODUCTION ENVIRONMENT VARIABLES — DO NOT COMMIT REAL VALUES
#
# Add each of these as GitHub Secrets:
# Repo → Settings → Secrets and variables → Actions → New repository secret
# ─────────────────────────────────────────────────────────────────────────────

# ── SSH / Hostinger access ────────────────────────────────────────────────────
SSH_HOST=your-hostinger-server-ip-or-domain
SSH_USER=your-ssh-username
SSH_PASSWORD=your-ssh-password
DEPLOY_PATH=/home/your-username/public_html/kenvies   # path on the server

# ── Database (Hostinger MySQL) ────────────────────────────────────────────────
DB_USER=u547313549_jpos_admin
DB_PASSWORD=Jpos2025
DB_NAME=u547313549_jpos

# ── Node API server ───────────────────────────────────────────────────────────
SERVER_PORT=4000
JWT_SECRET=generate-a-long-random-string-here

# ── Frontend (Vite) ───────────────────────────────────────────────────────────
VITE_NODE_API_URL=https://yourdomain.com/api
VITE_JPOS_ROOT=https://yourdomain.com/JPos
VITE_IMAGE_BASE_URL=https://kenvies.com/userfiles/product
CORS_ORIGIN=https://yourdomain.com

# ── Google OAuth (optional) ───────────────────────────────────────────────────
VITE_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
