# ─── React Router SPA fallback ───────────────────────────────────────────────
# Redirects all requests to index.html so React Router handles the routing.
# Without this, refreshing any page other than "/" gives a 404 on Apache servers.

Options -MultiViews
RewriteEngine On

# If the request is for a real file or directory, serve it directly
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d

# Otherwise rewrite to index.html
RewriteRule ^ index.html [L]
